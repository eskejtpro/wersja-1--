{
  "name": "planpasika-v2",
  "private": true,
  "version": "3.0.0",
  "description": "PlanPasika.v2 Android Training App",
  "author": "Pasik92",
  "engines": {
    "node": ">=20 <27",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --test tests/storage.test.cjs tests/circumference.test.cjs tests/body-measurements.test.cjs tests/body-weight-subcategories.test.cjs tests/domain-mappers.test.cjs tests/database-migration.test.cjs tests/room-database.test.cjs tests/workout-timer.test.cjs tests/room-initialization-flow.test.cjs",
    "test:server": "node --import tsx --test tests/server.test.cjs",
    "test:circumferences": "node tests/circumference-desktop-smoke.cjs",
    "desktop": "electron .",
    "dist": "npm run lint && npm test && npm run build && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "44.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "pl.pasik92.gymtrackerpro",
    "productName": "GymTracker Pro",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "GymTracker-Pro-Setup-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "GymTracker-Pro-Portable-x64.exe"
    }
  }
}
